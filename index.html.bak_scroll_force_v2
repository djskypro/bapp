  .messages { flex: 1; padding: 20px; overflow-y: auto; display: flex; flex-direction: column; gap: 10px; }
  .msg { max-width: 80%; padding: 10px 12px; border-radius: 12px; font-size: 15px; line-height: 1.4; position: relative; word-wrap: break-word; }
  .msg.received { background: var(--msg-received); align-self: flex-start; border-top-left-radius: 2px; }
  .msg.sent { background: var(--msg-sent); color: var(--text); align-self: flex-end; border-top-right-radius: 2px; }
  .msg-time { font-size: 10px; color: var(--text-muted); float: right; margin: 6px 0 0 12px; }
  .msg.sent .msg-time { color: rgba(255,255,255,0.7); }
  .light-mode .msg.sent .msg-time { color: #666; }
  .msg img { max-width: 100%; border-radius: 8px; margin-bottom: 5px; display: block; }
  .msg-status { font-size: 12px; margin-left: 5px; color: var(--text-muted); }
  .msg-status.read { color: #53bdeb; }

