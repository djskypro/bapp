  .search-box input { background: transparent; border: none; color: var(--text); font-size: 16px; width: 100%; outline: none; }
  #search-dropdown { display:none; position:absolute; top:60px; left:20px; right:20px; z-index:100; border-radius:12px; overflow:hidden; background: var(--glass-bg); backdrop-filter: blur(30px); border: 1px solid var(--glass-border); }

  .chat-list { flex: 1; overflow-y: auto; }
