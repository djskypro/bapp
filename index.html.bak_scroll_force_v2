    outline: none;
  }
  @keyframes geminiPulse {
    0% { opacity: 0.5; filter: blur(1px); transform: scale(0.98); }
    100% { opacity: 1; filter: blur(3px); transform: scale(1.02); }
  }

  
  /* --- FIX SCREEN FIT --- */
  html, body {
    height: 100dvh;
    width: 100vw;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background-color: #050505;
  }
  #main-view {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding-bottom: 0;
  }
  .chat-list {
    flex: 1;
    overflow-y: auto;
