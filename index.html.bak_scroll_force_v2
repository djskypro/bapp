  .send-btn { background: var(--primary); width: 45px; height: 45px; border-radius: 50%; display: flex; justify-content: center; align-items: center; color: black; font-size: 20px; cursor: pointer; }
  .attach-btn { font-size: 24px; color: var(--text-muted); padding: 10px; cursor: pointer; }

  .settings-content { padding: 20px; flex: 1; overflow-y: auto; }
