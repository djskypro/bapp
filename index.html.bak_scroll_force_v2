  }

  
  
  /* --- PITCH BLACK BACKGROUND --- */
  .snake-bg {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background-color: var(--bg); /* Follows light/dark mode */
    z-index: 0;
    pointer-events: none;
  }

  
  /* --- THE SPINNING SNAKE SPHERE --- */
  .snake-sphere {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 350px;
    height: 350px;
    border-radius: 50%;
    z-index: 1;
    pointer-events: none;
    overflow: hidden;
    
    /* Create the 3D sphere lighting effect */
    box-shadow: 
      inset 0 0 50px rgba(0,0,0,0.9), 
      inset 20px 20px 60px var(--snake-glow),
      0 0 50px var(--snake-glow);
      
    /* Fade the edges into the black background */
    mask-image: radial-gradient(circle, black 40%, transparent 75%);
    -webkit-mask-image: radial-gradient(circle, black 40%, transparent 75%);
    
    
  /* The sphere itself will breathe/grow slightly, NO TUMBLE */
  .snake-sphere {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 350px; height: 350px;
    border-radius: 50%;
    z-index: 0; /* Put it in the background */
    pointer-events: none;
    overflow: hidden;
    box-shadow: 
      inset 0 0 50px rgba(0,0,0,0.9), 
      inset 20px 20px 60px var(--snake-glow),
