    outline: none;
  }
  @keyframes geminiPulse {
    0% { opacity: 0.5; filter: blur(1px); }
    100% { opacity: 1; filter: blur(2px); box-shadow: 0 0 15px rgba(37, 211, 102, 0.2); }
  }

  

  
  /* COLORED SEARCH BAR GLOW */
  .search-glow-wrapper {
    position: relative;
    padding: 2px;
    border-radius: 14px;
    display: flex;
    width: 100%;
  }
  .search-glow {
    position: absolute;
    inset: 0;
    border-radius: 14px;
    background: radial-gradient(circle at 10% 50%, rgba(37, 211, 102, 0.8) 0%, transparent 40%),
                radial-gradient(circle at 90% 50%, rgba(0, 150, 255, 0.8) 0%, transparent 40%),
                radial-gradient(circle, rgba(255,255,255,0.6) 1px, transparent 1px);
    background-size: 100% 100%, 100% 100%, 6px 6px;
