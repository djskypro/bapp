  .nav-item.active { color: var(--primary); }
  .nav-item span { font-size: 22px; }
  .nav-badge { position: absolute; top: -5px; right: -10px; background: var(--primary); color: black; font-size: 10px; font-weight: bold; padding: 2px 6px; border-radius: 10px; display: none; }

  #chat-view, #settings-view, #contact-info-view { background: var(--bg); z-index: 30; }
